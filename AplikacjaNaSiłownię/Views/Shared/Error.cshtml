@model ErrorViewModel
@{
    ViewData["Title"] = "Błąd";
    ViewData["BodyClass"] = "bg-app-general";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card gym-card shadow-lg border-0">
            <div class="card-body p-5 text-center">
                <span class="display-3 text-danger"><i class="bi bi-exclamation-triangle"></i></span>
                <h2 class="text-white fw-bold mt-3">Coś poszło nie tak</h2>
                <p class="text-white-50">Wystąpił błąd podczas przetwarzania żądania. Spróbuj ponownie za chwilę.</p>

                @if (Model.ShowRequestId)
                {
                    <p class="text-white-50 small">Identyfikator żądania: <code>@Model.RequestId</code></p>
                }

                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-neon mt-3">
                    <i class="bi bi-arrow-left me-1"></i> Wróć na stronę główną
                </a>
            </div>
        </div>
    </div>
</div>
