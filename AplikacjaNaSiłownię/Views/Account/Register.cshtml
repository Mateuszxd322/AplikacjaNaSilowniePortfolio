@model AplikacjaNaSiłownię.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Rejestracja";

    ViewData["BodyClass"] = "bg-app-general";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card gym-card shadow-lg border-0 rounded-pilled">
            <div class="card-body p-5">
                <h2 class="text-center text-white mb-4">Rejestracja</h2>
                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Imie" class="form-control gym-input" placeholder="Imię" />
                        <label asp-for="Imie" class="text-muted">Imię</label>
                        <span asp-validation-for="Imie" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Nazwisko" class="form-control gym-input" placeholder="Nazwisko" />
                        <label asp-for="Nazwisko" class="text-muted">Nazwisko</label>
                        <span asp-validation-for="Nazwisko" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control gym-input" placeholder="Email" />
                        <label asp-for="Email" class="text-muted">Email</label>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3 position-relative">
                        <input asp-for="Password" class="form-control gym-input pe-5" placeholder="Hasło"
                            id="registerPassword" />
                        <label asp-for="Password" class="text-muted">Hasło</label>
                        <button type="button"
                            class="btn position-absolute top-50 end-0 translate-middle-y px-3 border-0 text-muted"
                            onclick="togglePasswordVisibility('registerPassword', this)" tabindex="-1">
                            <i class="bi bi-eye"></i>
                        </button>
                        <span asp-validation-for="Password" class="text-danger d-block mt-1"></span>
                    </div>

                    <div class="form-floating mb-3 position-relative">
                        <input asp-for="ConfirmPassword" class="form-control gym-input pe-5"
                            placeholder="Potwierdź hasło" id="registerConfirmPassword" />
                        <label asp-for="ConfirmPassword" class="text-muted">Potwierdź hasło</label>
                        <button type="button"
                            class="btn position-absolute top-50 end-0 translate-middle-y px-3 border-0 text-muted"
                            onclick="togglePasswordVisibility('registerConfirmPassword', this)" tabindex="-1">
                            <i class="bi bi-eye"></i>
                        </button>
                        <span asp-validation-for="ConfirmPassword" class="text-danger d-block mt-1"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <select asp-for="Rola" class="form-select gym-input">
                            <option value="Klient">Klient</option>
                            <option value="Trener">Trener</option>
                        </select>
                        <label asp-for="Rola" class="text-muted">Rola w systemie</label>
                        <span asp-validation-for="Rola" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-neon btn-lg text-uppercase fw-bold">Zarejestruj
                            się</button>
                    </div>
                </form>

                <div class="text-center mt-4">
                    <span class="text-gray-400">Masz już konto? </span>
                    <a asp-action="Login" class="text-neon text-decoration-none">Zaloguj się</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
