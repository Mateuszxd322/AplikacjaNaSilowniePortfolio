@model AplikacjaNaSiłownię.Models.ApplicationUser

@{
    ViewData["Title"] = "Mój Trener";
    ViewData["BodyClass"] = "bg-app-general";
    var history = ViewBag.History as IEnumerable<AplikacjaNaSiłownię.Models.CollaborationHistory>;
}

<div class="row mb-4">
    <div class="col-12 text-center">
        <h2 class="text-neon text-uppercase fw-bold">Twój Trener Personalny</h2>
        <p class="text-white-50">Zarządzaj swoją współpracą</p>
    </div>
</div>

<div class="row mb-5 justify-content-center">
    <div class="col-md-8">
        @if (Model == null)
        {
            <div class="card gym-card border-secondary border shadow p-5 text-center">
                <h4 class="text-white-50"><i class="bi bi-person-x fs-1 d-block mb-3"></i>Brak trenera</h4>
                <p class="text-muted mb-0">Obecnie nie współpracujesz z żadnym trenerem personalnym.</p>
            </div>
        }
        else
        {
            <div class="card gym-card border-info border shadow p-4">
                <div class="row align-items-center">
                    <div class="col-auto text-info display-1">
                        <i class="bi bi-person-badge-fill"></i>
                    </div>
                    <div class="col">
                        <h3 class="text-white mb-2">@Model.FirstName @Model.LastName</h3>
                        <p class="text-muted mb-1"><i class="bi bi-envelope me-2"></i> @Model.Email</p>
                        @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                        {
                            <p class="text-muted mb-0"><i class="bi bi-telephone me-2"></i> @Model.PhoneNumber</p>
                        }
                    </div>
                    <div class="col-12 col-md-auto mt-4 mt-md-0 text-center text-md-end">
                        <button type="button" class="btn btn-outline-danger" id="btnRemoveTrainer">
                            <i class="bi bi-person-dash"></i> Zakończ współpracę
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@if (history != null && history.Any())
{
    <div class="row mb-3">
        <div class="col-12">
            <h4 class="text-white border-bottom border-secondary pb-2"><i class="bi bi-clock-history me-2 text-neon"></i> Historia współprac</h4>
        </div>
    </div>
    
    <div class="row">
        @foreach (var record in history)
        {
            <div class="col-12 mb-3">
                <div class="card gym-card border-0 bg-dark shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h5 class="text-white mb-0">Trener: @record.TrainerName</h5>
                            <div>
                                <span class="badge bg-secondary me-2">Zakończono: @record.EndDate.ToString("dd.MM.yyyy HH:mm")</span>
                                <button type="button" class="btn btn-outline-danger btn-sm border-0 btn-delete-history" data-id="@record.Id" title="Usuń z historii">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                        <p class="text-muted small mb-2">Inicjator zakończenia: <strong class="text-light">@record.EndedByRole</strong></p>
                        <div class="alert alert-secondary p-2 mb-0">
                            <strong>Powód:</strong> @record.Reason
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const btn = document.getElementById('btnRemoveTrainer');
            if(btn) {
                btn.addEventListener('click', function() {
                    gymPrompt("Zanim zakończysz współpracę, podaj powód. Zostanie on zapisany w historii.", function(reason) {
                        const payload = { reason: reason };
                        fetch('/Klient/RemoveTrainer', {
                            method: 'POST',
                            headers: { 
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                            },
                            body: JSON.stringify(payload)
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                gymAlert("Współpraca została zakończona.", "info");
                                setTimeout(() => location.reload(), 1500);
                            } else {
                                gymAlert(data.message || "Wystąpił błąd.", "error");
                            }
                        })
                        .catch(err => {
                            console.error(err);
                            gymAlert("Wystąpił błąd połączenia z serwerem.", "error");
                        });
                    });
                });
            }

            const deleteHistoryBtns = document.querySelectorAll('.btn-delete-history');
            deleteHistoryBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    const recordId = this.getAttribute('data-id');
                    gymConfirm("Czy na pewno chcesz usunąć ten wpis z historii?", function() {
                        fetch('/Klient/DeleteHistoryRecord', {
                            method: 'POST',
                            headers: { 
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                            },
                            body: JSON.stringify(parseInt(recordId))
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                gymAlert("Wpis został usunięty.", "success");
                                setTimeout(() => location.reload(), 1500);
                            } else {
                                gymAlert("Wystąpił błąd podczas usuwania.", "error");
                            }
                        });
                    });
                });
            });
        });
    </script>
}
