@model AplikacjaNaSiłownię.Models.ApplicationUser

@{
    ViewData["Title"] = "Zaproszenie od Trenera";

    ViewData["BodyClass"] = "bg-app-general";
}

<div class="row mb-4">
    <div class="col-12 text-center">
        <h2 class="text-neon text-uppercase fw-bold">Moje Zaproszenia</h2>
        <p class="text-white-50">Zarządzaj prośbami o współpracę od trenerów.</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        @if (Model == null)

        {
            <div class="card gym-card border-0 shadow text-center p-5">
                <h4 class="text-white-50"><i class="bi bi-inbox fs-1 d-block mb-3"></i>Brak nowych zaproszeń</h4>
                <p class="text-muted">Obecnie żaden trener nie wysłał Ci zaproszenia do współpracy.</p>
            </div>
        }

        else

        {
            <div class="card gym-card border-warning border shadow p-0 overflow-hidden">
                <div class="bg-warning text-dark px-4 py-2 fw-bold">
                    <i class="bi bi-star-fill me-2"></i> Nowe Zaproszenie do Współpracy
                </div>
                <div class="p-4">
                    <div class="row align-items-center mb-3">
                        <div class="col-auto">
                            <div class="display-4 text-warning">
                                <i class="bi bi-person-circle"></i>
                            </div>
                        </div>
                        <div class="col">
                            <h3 class="text-white mb-1">Trener: @Model.FirstName @Model.LastName</h3>
                            <p class="text-muted mb-0"><i class="bi bi-envelope me-2"></i> @Model.Email</p>
                            @if (!string.IsNullOrEmpty(Model.PhoneNumber))

                            {
                                <p class="text-muted mb-0"><i class="bi bi-telephone me-2"></i> @Model.PhoneNumber</p>
                            }
                        </div>
                    </div>

                    <div class="alert alert-dark border-secondary text-light mb-4">
                        <i class="bi bi-chat-quote-fill text-warning fs-4 float-start me-3"></i>
                        Cześć! Przejrzałem Twój profil i chciałbym zostać Twoim trenerem personalnym.
                        Zaakceptuj to zaproszenie, abyśmy mogli wspólnie zaplanować Twoje treningi i osiągnąć Twoje cele
                        sylwetkowe.
                    </div>

                    <div class="d-flex justify-content-end gap-2 border-top border-secondary pt-3">
                        <form asp-action="RejectRequest" method="post"
                            onsubmit="event.preventDefault(); gymConfirm('Czy na pewno chcesz odrzucić to zaproszenie?', () => this.submit());">
                            <button type="submit" class="btn btn-outline-danger px-4"><i class="bi bi-x-circle me-1"></i>
                                Odrzuć zaproszenie</button>
                        </form>
                        <form asp-action="AcceptRequest" method="post"
                            onsubmit="event.preventDefault(); gymConfirm('Czy na pewno chcesz rozpocząć współpracę z tym trenerem?', () => this.submit());">
                            <button type="submit" class="btn btn-success px-4"><i class="bi bi-check-circle me-1"></i>
                                Akceptuj współpracę</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
