@{
    ViewData["Title"] = "Strona Główna";
    ViewData["BodyClass"] = "bg-home";
}

<style>
    .home-overlay {
        background-color: rgba(33, 37, 41, 0.85); 
        min-height: 70vh;
        border-radius: 20px;
        backdrop-filter: blur(10px);
        box-shadow: 0 0 20px rgba(57, 255, 20, 0.15);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
</style>
<div class="text-center home-overlay p-5 mt-4 d-flex flex-column justify-content-center align-items-center mx-auto" style="max-width: 900px;">
    <span class="display-1 text-neon mb-3"><i class="bi bi-activity"></i></span>
    <h1 class="display-3 text-neon fw-bold mb-4 text-uppercase">Witaj w Gym App</h1>
    <p class="lead text-white mb-5 fs-4">Twoje centrum zarządzania treningami. Umawiaj spotkania, rozwijaj panel podopiecznych i sprawdzaj progres kalendarza w jednym miejscu.</p>
    
    @if (User.Identity?.IsAuthenticated != true)
    {
        <div class="d-flex flex-wrap gap-4 justify-content-center mt-3">
            <a class="btn btn-outline-neon btn-lg px-5 py-3 rounded-pill text-uppercase fw-bold" style="font-size: 1.2rem;" asp-controller="Account" asp-action="Register">Rozpocznij teraz</a>
            <a class="btn btn-outline-neon btn-lg px-5 py-3 rounded-pill text-uppercase fw-bold" style="font-size: 1.2rem;" asp-controller="Account" asp-action="Login">Zaloguj się</a>
        </div>
    }
    else
    {
        <h4 class="text-light">Zalogowano pomyślnie. Przejdź do swojego panelu w menu u góry.</h4>
    }
</div>
